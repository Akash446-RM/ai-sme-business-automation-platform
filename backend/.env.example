# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="AI-Powered SME Business Automation Platform"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=sme_ai_platform

# ---------------------------------------------------------------------------
# Security
# Generate a strong secret:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Business rules
# ---------------------------------------------------------------------------
GST_RATE=18.0
CURRENCY=INR
CURRENCY_SYMBOL=Rs.
DEFAULT_LEAD_TIME_DAYS=5
SERVICE_LEVEL_Z=1.65

# ---------------------------------------------------------------------------
# Machine learning
# ---------------------------------------------------------------------------
ML_MODEL_DIR=ml_models
FORECAST_DEFAULT_HORIZON=7

# ---------------------------------------------------------------------------
# AI / LLM layer
# LLM_PROVIDER: offline | openai_compat | gemini | ollama
#   offline        -> deterministic, template based, no API key required
#   openai_compat  -> OpenAI / Groq / OpenRouter / vLLM / LM Studio
#   gemini         -> Google Generative Language API
#   ollama         -> local Ollama server
# ---------------------------------------------------------------------------
LLM_PROVIDER=offline
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=900
